{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "AutoAudit workload scaling — pod counts, HPA / KEDA signals, and per-workload metrics during synthetic load runs. Pairs with tests/load/*.js.",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["autoaudit", "scaling"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "label": "Datasource",
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "current": { "selected": false, "text": "autoaudit", "value": "autoaudit" },
        "label": "Namespace",
        "name": "namespace",
        "type": "constant",
        "query": "autoaudit"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "title": "AutoAudit — Scaling Demo",
  "uid": "autoaudit-scaling",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Pod counts",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Pods running per workload",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Live pod count per Deployment. Climbs when load arrives, drops when KEDA / HPA scale back down.",
      "gridPos": { "x": 0, "y": 1, "w": 16, "h": 8 },
      "targets": [
        {
          "expr": "sum by (deployment) (kube_deployment_status_replicas_available{namespace=\"$namespace\", deployment=~\"autoaudit-(backend-api|frontend|opa|powershell-service|worker-.+)\"})",
          "legendFormat": "{{deployment}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0, "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Current pod totals",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "sum by (deployment) (kube_deployment_status_replicas_available{namespace=\"$namespace\", deployment=~\"autoaudit-(backend-api|frontend|opa|powershell-service|worker-.+)\"})",
          "legendFormat": "{{deployment}}",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "graphMode": "area", "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "row",
      "title": "HPA / KEDA scaling signals",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HPA: current vs desired replicas",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "When desired > current, the HPA is asking for more pods. When they meet, scaling has settled.",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"$namespace\"}",
          "legendFormat": "{{horizontalpodautoscaler}} — current",
          "refId": "A"
        },
        {
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"$namespace\"}",
          "legendFormat": "{{horizontalpodautoscaler}} — desired",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2 } }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "KEDA queue depth (Redis lists)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Pending tasks per worker queue. The headline 'work waiting' signal — KEDA scales pods until this drains.",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "redis_db_keys{db=\"db0\"} unless on() vector(0)",
          "legendFormat": "redis db0 keys (proxy for queue depth)",
          "refId": "A"
        },
        {
          "expr": "keda_scaler_metrics_value{namespace=\"$namespace\"}",
          "legendFormat": "{{scaledObject}} — {{scaler}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Backend-api",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Backend-api: requests/sec",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 19, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\", job=\"autoaudit-backend-api\", handler!~\"/metrics|/healthz.*\"}[1m]))",
          "legendFormat": "all handlers",
          "refId": "A"
        },
        {
          "expr": "sum by (handler) (rate(http_requests_total{namespace=\"$namespace\", job=\"autoaudit-backend-api\", handler!~\"/metrics|/healthz.*\"}[1m]))",
          "legendFormat": "{{handler}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Backend-api: p90 / p95 / p99 latency",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 8, "y": 19, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.90, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", job=\"autoaudit-backend-api\", handler!~\"/metrics|/healthz.*\"}[1m])))",
          "legendFormat": "p90",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", job=\"autoaudit-backend-api\", handler!~\"/metrics|/healthz.*\"}[1m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", job=\"autoaudit-backend-api\", handler!~\"/metrics|/healthz.*\"}[1m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Backend-api: CPU per pod",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Per-pod CPU. Compare against HPA target (default 70% of request).",
      "gridPos": { "x": 16, "y": 19, "w": 8, "h": 7 },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"autoaudit-backend-api-.*\", container=\"backend-api\"}[1m])",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Worker — per-queue throughput",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Worker pods per queue",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 27, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "sum by (deployment) (kube_deployment_status_replicas_available{namespace=\"$namespace\", deployment=~\"autoaudit-worker-.+\"})",
          "legendFormat": "{{deployment}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0, "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20 } }, "overrides": [] }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Celery tasks/sec by queue (requires celery-exporter)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Optional. Install danihodovic/celery-exporter pointed at the same broker to populate this.",
      "gridPos": { "x": 12, "y": 27, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "sum by (queue_name) (rate(celery_task_succeeded_total{namespace=\"$namespace\"}[1m]))",
          "legendFormat": "{{queue_name}} — succeeded",
          "refId": "A"
        },
        {
          "expr": "sum by (queue_name) (rate(celery_task_failed_total{namespace=\"$namespace\"}[1m]))",
          "legendFormat": "{{queue_name}} — failed",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] }
    },
    {
      "id": 40,
      "type": "row",
      "title": "PowerShell service",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Active pwsh subprocesses (per pod)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Custom gauge from engine/powershell/service/metrics.py. Each line = one pod's currently-running pwsh subprocesses.",
      "gridPos": { "x": 0, "y": 35, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "pwsh_active_subprocesses{namespace=\"$namespace\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0, "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "pwsh executions/sec by module + outcome",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 35, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "sum by (module, outcome) (rate(pwsh_executions_total{namespace=\"$namespace\"}[1m]))",
          "legendFormat": "{{module}} / {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] }
    },
    {
      "id": 50,
      "type": "row",
      "title": "OPA",
      "gridPos": { "x": 0, "y": 42, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 51,
      "type": "timeseries",
      "title": "OPA decisions/sec",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "From OPA's native /metrics — http_request_duration_seconds_count for /v1/data eval requests.",
      "gridPos": { "x": 0, "y": 43, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count{namespace=\"$namespace\", pod=~\"autoaudit-opa-.*\", code=~\"2..\", handler!~\"health|metrics\"}[1m]))",
          "legendFormat": "decisions/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] }
    },
    {
      "id": 52,
      "type": "timeseries",
      "title": "OPA: p95 eval latency",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 43, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\", pod=~\"autoaudit-opa-.*\", handler!~\"health|metrics\"}[1m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] }
    },
    {
      "id": 43,
      "type": "timeseries",
      "title": "PowerShell service: CPU per pod",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Per-pod CPU. Compare against HPA target (70% of request). Each pod approaching threshold drives a scale-up event.",
      "gridPos": { "x": 0, "y": 57, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"autoaudit-powershell-service-.*\", container=\"powershell-service\"}[1m])",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 53,
      "type": "timeseries",
      "title": "OPA: CPU per pod",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Per-pod CPU. Compare against HPA target (60% of request). Per-call work is short so curves track decision rate cleanly.",
      "gridPos": { "x": 12, "y": 57, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"autoaudit-opa-.*\", container=\"opa\"}[1m])",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "decimals": 2 }, "overrides": [] }
    }
  ]
}
